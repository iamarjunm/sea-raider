		{
			"label": "Validate math publish files",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require('fs'); const path=require('path'); const root='maths'; const idx=JSON.parse(fs.readFileSync(path.join(root,'index.json'),'utf8')); if(!Array.isArray(idx.modes)||idx.modes.length<1) throw Error('modes missing'); const names=new Set(); for(const m of idx.modes){ if(names.has(m.name.toLowerCase())) throw Error('duplicate mode'); names.add(m.name.toLowerCase()); const events=fs.readFileSync(path.join(root,m.events),'utf8').trim().split(/\\r?\\n/).filter(Boolean).map(JSON.parse); const rows=fs.readFileSync(path.join(root,m.weights),'utf8').trim().split(/\\r?\\n/).filter(Boolean).map((line)=>line.split(',')); if(events.length!==rows.length) throw Error(m.name+' row count mismatch'); for(let i=0;i<events.length;i++){ if(!Number.isInteger(events[i].id)||!Array.isArray(events[i].events)||!Number.isInteger(events[i].payoutMultiplier)||events[i].payoutMultiplier<0) throw Error(m.name+' invalid event'); if(rows[i].length!==3||rows[i][2]!==String(events[i].payoutMultiplier)) throw Error(m.name+' payout mismatch'); if(!/^\\d+$/.test(rows[i][0])||!/^\\d+$/.test(rows[i][1])||Number(rows[i][1])<0) throw Error(m.name+' invalid CSV'); } } console.log('Valid math publish files:',idx.modes.length,'modes');"
			],
			"isBackground": false,
			"problemMatcher": []
		},
